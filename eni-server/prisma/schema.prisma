generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String  @id @default(uuid())
  email                 String  @unique
  isEmailConfirmed      Boolean @default(false)
  username              String
  password              String
  emailConfirmationLink String? @unique
  token                 Token?
}

model Token {
  userId       String  @id()
  user         User    @relation(fields: [userId], references: [id])
  refreshToken String?
}
