generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  isEmailConfirmed      Boolean    @default(false)
  username              String
  password              String
  emailConfirmationLink String?    @unique
  token                 Token?
  userWords             UserWord[]
}

model Token {
  userId       String  @id()
  user         User    @relation(fields: [userId], references: [id])
  refreshToken String?
}

model Word {
  id        String     @id()
  userWords UserWord[]
  text      String     @unique
}

model UserWord {
  userId            String
  user              User    @relation(fields: [userId], references: [id])
  wordId            String
  word              Word    @relation(fields: [wordId], references: [id])
  fileId            Int
  page              Int
  subtitleTimecode  String
  subtitleWordIndex Int
  movieId           Int
  isLearned         Boolean
  isFavorite        Boolean

  @@id([userId, wordId])
  @@unique([userId, wordId])
}
