{
	"compilerOptions": {
		"target": "es2022",
		"module": "CommonJS",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"outDir": "dist",
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@/types": ["../shared/types"]
		}
	},
	"exclude": ["node_modules"]
}
