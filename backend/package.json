{
	"name": "eni-backend",
	"version": "0.0.1",
	"author": "j-0-n-e-z",
	"type": "commonjs",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"start": "tsc && node dist/index.js",
		"dev": "nodemon src/index.ts",
		"test": "jest",
		"prisma:reset": "npx prisma migrate reset --force",
		"prisma:init": "npx prisma migrate dev --name init",
		"prisma:generate": "npx prisma generate",
		"prisma:pushdb": "npx prisma db push --force-reset",
		"prisma:setup": "npm run prisma:reset && npm run prisma:init && npm run prisma:generate",
		"lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\"",
		"lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix"
	},
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "^6.12.0",
		"axios": "^1.8.4",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.18.2",
		"https": "^1.0.0",
		"jsonwebtoken": "^9.0.2",
		"nodemailer": "^7.0.5",
		"pg": "^8.16.3",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@mermaid-js/mermaid-cli": "^11.9.0",
		"@tsconfig/node-lts": "^18.12.4",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.13",
		"@types/express": "^4.17.23",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20.5.6",
		"@types/nodemailer": "^6.4.17",
		"@types/pg": "^8.15.4",
		"@types/uuid": "^9.0.2",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"dotenv": "^16.3.1",
		"eslint": "^8.57.1",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-config-airbnb-typescript": "^18.0.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-import": "^2.32.0",
		"jest": "^29.7.0",
		"nodemon": "^3.0.1",
		"path": "^0.12.7",
		"prettier": "^3.6.2",
		"prisma": "^6.12.0",
		"prisma-erd-generator": "^2.0.4",
		"ts-jest": "^29.3.2",
		"ts-node": "^10.9.1",
		"typescript": "^5.2.2"
	}
