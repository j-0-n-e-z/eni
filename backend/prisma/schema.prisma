generator client {
  provider = "prisma-client-js"
}

// generator erd {
//   provider = "prisma-erd-generator"
// }

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DB_URL")
}

model User {
  id                    String     @id @default(uuid())
  email                 String     @unique
  isEmailConfirmed      Boolean    @default(false)
  username              String
  password              String
  emailConfirmationLink String?    @unique
  token                 Token?
  userWords             UserWord[]
}

model Token {
  userId       String  @id()
  user         User    @relation(fields: [userId], references: [id])
  refreshToken String?
}

model Word {
  id          String     @id()
  userWords   UserWord[]
  text        String     @unique
  translation String
  sources     Json
  isJoined    Boolean
}

model UserWord {
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  text       String
  mySources  Json
  word       Word    @relation(fields: [text], references: [text])
  isLearned  Boolean
  isFavorite Boolean

  @@id([userId, text])
}
