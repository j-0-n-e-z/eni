{
	"compilerOptions": {
		"target": "es2022",
		"module": "CommonJS",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"outDir": "./dist",
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@/shared-types": ["../shared/types"]
		},
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true
	},
	"exclude": ["node_modules", "dist", "**/*.test.ts"]
}
